# Publish mod configuration, the customized Survival map, and documentation.
/*
!/.gitignore
!/README.md
!/INI/
!/doc/
/INI/*
!/INI/Map Code/
!/INI/Game Options/
/INI/Map Code/*
!/INI/Map Code/*.ini
!/INI/Map Code/*.original_backup
/INI/Game Options/*
!/INI/Game Options/AI/
/INI/Game Options/AI/*
!/INI/Game Options/AI/Extreme AI Beta.ini
/doc/*
!/doc/status.md
!/doc/backups/

# Include the lobby settings and exact Survival map required by the fixes.
!/INI/MPMaps.ini
!/Maps/
/Maps/*
!/Maps/Yuri's Revenge/
/Maps/Yuri's Revenge/*
!/Maps/Yuri's Revenge/Survival/
/Maps/Yuri's Revenge/Survival/*
!/Maps/Yuri's Revenge/Survival/1_survive_death_r3_dctanxman.map

# Client configuration to bypass and block auto-update notifications
!/Resources/
/Resources/*
!/Resources/ClientDefinitions.ini
!/Client/
/Client/*
!/Client/UpdaterConfig.ini
!/updateconfig.ini
